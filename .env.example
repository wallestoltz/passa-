# Kopiera till .env.local när du kör lokalt, eller lägg in värdena under Settings → Environment Variables i Vercel.
# Hemlig nyckel från Stripe Dashboard → Utvecklare → API-nycklar. Börja med testnyckeln (sk_test_...).
STRIPE_SECRET_KEY=sk_test_...
# Adressen där sidan ligger, till exempel https://passa.vercel.app
PUBLIC_URL=
# Valfritt: Passas avgift i procent av varje betalning (0–50). Lämna 0 om ingen avgift ska tas.
PLATFORM_FEE_PERCENT=0
# Valfritt: signeringsnyckel för webhooken (whsec_...), från Stripe Dashboard → Utvecklare → Webhooks.
STRIPE_WEBHOOK_SECRET=
